  "blocks": [
    {
      "type": "text",
      "gap": 16,
      "role": "eyebrow",
      "text": "DİKİŞ KULÜBÜ / ADIM 2 / 5"
    },
    {
      "type": "text",
      "gap": 16,
      "role": "title",
      "text": "İpliği iğneden geçirin"
    },
    {
      "type": "text",
      "gap": 16,
      "role": "body",
      "text": "İpliğin ucunu düz kesin. İğneyi ışığa doğru tutun ve ipliği delikten yavaşça geçirin."
    },
    {
      "type": "text",
      "gap": 16,
      "role": "heading",
      "text": "Yanınızda olsun"
    },
    {
      "type": "text",
      "gap": 16,
      "role": "body",
      "text": "İğne · Pamuklu iplik · Küçük makas"
    },
    {
      "type": "rule",
      "gap": 16,
      "color": "#a9b7b2",
      "thickness": 1
    },
    {
      "type": "text",
      "gap": 16,
      "role": "body",
      "text": "1. İpliği yaklaşık 40 cm uzunluğunda kesin."
    },
    {
      "type": "text",
      "gap": 16,
      "role": "body",
      "text": "2. Ucu parmaklarınızın arasında sıkıştırın."
    },
    {
      "type": "text",
      "gap": 16,
      "role": "body",
      "text": "3. İpliği geçirin; iki ucu eşitlemeyin."
    },
    {
      "type": "panel",
      "gap": 16,
      "blocks": [
        {
          "type": "text",
          "gap": 0,
          "role": "caption",
          "text": "Küçük ipucu: Uzun iplik daha çok dolaşır. Kısa bir parça ile başlayın."
        }
      ],
      "background": "#f6e7ad",
      "padding": 14
    },
    {
      "type": "panel",
      "gap": 16,
      "blocks": [
        {
          "type": "text",
          "gap": 0,
          "role": "button",
          "text": "Hazırım, devam edelim"
        }
      ],
      "background": "#244542",
      "padding": 14
    },
    {
      "type": "text",
      "gap": 16,
      "role": "caption",
      "text": "İlerlemeniz bu telefonda saklanır."
    }
  ]
